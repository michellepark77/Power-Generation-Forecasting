#adding callibration layer to LSTM model
import numpy as np
from sklearn.linear_model import LinearRegression
from sklearn.metrics import mean_squared_error, mean_absolute_error


def calibrate_predictions(y_true, y_pred):
    """
    Fits a linear calibration model to adjust raw model predictions.
    """

    y_true = np.array(y_true)
    y_pred = np.array(y_pred)

    calibration_model = LinearRegression()

    calibration_model.fit(
        y_pred.reshape(-1, 1),
        y_true
    )

    calibrated_predictions = calibration_model.predict(
        y_pred.reshape(-1, 1)
    )

    calibrated_predictions = np.clip(
        calibrated_predictions,
        0,
        None
    )

    return {
        "calibrated_predictions": calibrated_predictions,
        "slope": calibration_model.coef_[0],
        "intercept": calibration_model.intercept_
    }


def compare_calibration_results(
    y_true,
    raw_predictions,
    calibrated_predictions
):
    """
    Compares raw model predictions against calibrated predictions.
    """

    original_rmse = np.sqrt(
        mean_squared_error(
            y_true,
            raw_predictions
        )
    )

    calibrated_rmse = np.sqrt(
        mean_squared_error(
            y_true,
            calibrated_predictions
        )
    )

    original_mae = mean_absolute_error(
        y_true,
        raw_predictions
    )

    calibrated_mae = mean_absolute_error(
        y_true,
        calibrated_predictions
    )

    original_bias = np.mean(
        raw_predictions - y_true
    )

    calibrated_bias = np.mean(
        calibrated_predictions - y_true
    )

    return {
        "original_rmse": original_rmse,
        "calibrated_rmse": calibrated_rmse,
        "rmse_improvement": original_rmse - calibrated_rmse,
        "original_mae": original_mae,
        "calibrated_mae": calibrated_mae,
        "mae_improvement": original_mae - calibrated_mae,
        "original_bias": original_bias,
        "calibrated_bias": calibrated_bias
    }
